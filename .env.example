DATABASE_URL=postgres://qcwarehouse:qcwarehouse@localhost:5432/qcwarehouse
APP_URL=http://localhost:3000
# Generate an independent random secret of at least 32 characters.
AUTH_OTP_PEPPER=
# Development only. Demo checkouts and displayed OTP codes are disabled in a production build.
QCW_DEMO=0
POSTMARK_SERVER_TOKEN=
POSTMARK_MESSAGE_STREAM=outbound
POSTMARK_WEBHOOK_TOKEN=
EMAIL_FROM=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_LIVE_ENABLED=0
# Enable only after the public report sharing acceptance checks.
REPORT_SHARING_ENABLED=0
KUAIDI100_KEY=
KUAIDI100_CUSTOMER=
TRACKING_CALLBACK_BASE_URL=
# Must point to a separate disposable qcw_test database.
TEST_DATABASE_URL=
