{
  "name": "qcwarehouse",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "check": "tsc --noEmit",
    "db:migrate": "node --env-file-if-exists=.env scripts/migrate.mjs",
    "db:demo": "node --env-file-if-exists=.env --import tsx scripts/demo.ts",
    "test:integration": "node --env-file-if-exists=.env --import tsx --test tests/workflow.test.mts",
    "worker": "node --env-file-if-exists=.env --import tsx scripts/worker.ts",
    "integrations:check": "node --env-file-if-exists=.env --import tsx scripts/integration-preflight.ts"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "next": "16.4.5",
    "openid-client": "6.8.9",
    "pdf-lib": "1.17.1",
    "pg": "8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "sharp": "0.35.5",
    "stripe": "23.1.0",
    "yaml": "2.9.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  }
}
